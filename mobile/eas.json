{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_CHANNEL": "store" }
    },
    "direct": {
      "distribution": "internal",
      "channel": "direct",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_CHANNEL": "direct" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_CHANNEL": "store" }
    }
  },
  "submit": {
    "production": {}
  }
}
