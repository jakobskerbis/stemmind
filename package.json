{
  "name": "stemmind",
  "version": "0.1.0",
  "private": true,
  "description": "Kompreno – AI inštruktor za matematiko, fiziko in kemijo",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "STEMMIND_MOCK=1 node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "sim": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning sim/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "lucide-static": "^1.62.0"
  }
}
