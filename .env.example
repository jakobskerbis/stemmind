# Obvezno za prave odgovore (brez ključa teče preizkusni način)
ANTHROPIC_API_KEY=

# Neobvezno
PORT=3000
EVKLID_PASSWORD=                  # če je nastavljeno, stran zahteva geslo (uporabnik je poljuben)
EVKLID_DB=data/evklid.db

# Modeli in stroški
EVKLID_MODEL=claude-haiku-5-5     # privzeti, poceni model za klepet
EVKLID_MODEL_DEEP=claude-opus-5-5 # »Razloži podrobneje« (in Tekmovanja, če EVKLID_COMPETITION_DEEP=1)
EVKLID_MODEL_MID=claude-sonnet-5-5 # namesto Opusa za imetnike aktivacijske kode
EVKLID_EFFORT=                    # prazno = low (low | medium | high)
EVKLID_EFFORT_DEEP=               # prazno = low; medium = več razmišljanja Opusa (dražje)
EVKLID_EFFORT_THINK=              # prazno = high: Haiku za Tekmovanja in nad omejitvijo Opusa
EVKLID_MAX_TOKENS=                # prazno = 3000 (lahki način 1200, Haiku+razmislek 5000, Opus 6000)
EVKLID_DEEP_HISTORY_TURNS=        # prazno = 3: koliko zadnjih izmenjav dobi Opus
EVKLID_DEEP_CACHE_TTL=            # prazno = 1h: predpomnilnik prompta za Opus (5m = krajši)
EVKLID_COMPETITION_DEEP=0         # 1 = Tekmovanja vedno z Opusom (dražje, prej privzeto)
EVKLID_OCR_MODEL=                 # branje rokopisa; prazno = EVKLID_MODEL
EVKLID_HISTORY_TURNS=10           # koliko izmenjav zgodovine gre v API (0 = vse)
EVKLID_ANSWER_CACHE=1             # 0 = ne uporabljaj shranjenih odgovorov na enaka prva vprašanja
EVKLID_LIVE_CHECK=1               # 0 = brez sprotnega preverjanja odgovorov (rezultat reševalnika vnaprej, preračun kode, popravek, pregled s Sonnetom)
EVKLID_LIVE_CHECK_DAILY_USD=1     # največ $ na dan za sprotni pregled s Sonnetom (tekmovanja, fakulteta, »Razloži podrobneje«)

# Omejitve (0 = brez omejitve)
EVKLID_DAILY_QUESTIONS=0          # vprašanj za inštruktorja na učenca na dan, npr. 10
EVKLID_MONTHLY_BUDGET_USD=0       # skupni mesečni proračun API v $ (npr. 200 iz Claude Max): modeli se mu prilagajajo, inštruktor ga ne preseže; skrbnik ga spremeni v števcu porabe
EVKLID_BUDGET_RESERVE_PCT=3       # rezerva pod proračunom v %, ustavi se prej
EVKLID_BUDGET_BURST=2             # nadgradnje modela počakajo do jutri, ko je danes porabljeno 2× dnevnega deleža
EVKLID_STUDENT_SOFT_USD=          # prazno = 1: nad tem na mesec podrobne razlage pripravi Haiku
EVKLID_STUDENT_MONTHLY_USD=       # prazno = 3: nad tem na mesec inštruktor počaka (Vadnica deluje)
EVKLID_DAILY_DEEP=                # prazno = 5: odgovorov Opusa na učenca na dan
EVKLID_EUR_PER_USD=               # prazno = 0.87: tečaj za prikaz stroškov v evrih

# Vnaprej pripravljene razlage tem (scripts/generate-explanations.js)
EVKLID_EXPLANATIONS=content/explanations.json
EVKLID_EXPLAIN_MODEL=claude-opus-5-5

EVKLID_DEBUG=0                    # 1 = /api/students/:id/prompt pokaže sestavljeni prompt
EVKLID_MOCK=0                     # 1 = vedno preizkusni način

# Starševski računi in plačila (1 = prijava staršev, soglasja, naročnine)
EVKLID_ACCOUNTS=0
EVKLID_ACCOUNT_LOCK=0               # 1 = zavihek Račun in dejanja lastnika zahtevajo geslo računa (privzeto: geslo samo enkrat)
EVKLID_ACCOUNT_UNLOCK_MIN=10        # koliko minut po zadnji uporabi ostane račun odklenjen na napravi
EVKLID_BASE_URL=                  # javni naslov, npr. https://evklid.onrender.com (za povezave v e-pošti)
EVKLID_ADMIN_EMAILS=              # e-naslovi skrbnikov (vidijo porabo AI, prevzamejo stare profile)
EVKLID_EXPORT_TOKEN=              # vsaj 24 znakov: ključ za tedenski izvoz kozmetike (Authorization: Bearer …)
EVKLID_FREE_DAILY_QUESTIONS=10    # brezplačni paket: vprašanj inštruktorju na otroka na dan
EVKLID_OSEBNO_DAILY_QUESTIONS=60  # osebni paket (naročnina, preizkus, koda, bonus, paket pred testom): vprašanj inštruktorju na dan (0 = brez meje)
EVKLID_SOLA_DAILY_QUESTIONS=15    # šolska licenca: vprašanj inštruktorju na dan (0 = brez meje); z osebnim paketom se meji seštejeta
EVKLID_FREE_POOL_USD=10           # brezplačni paket: največ $ na mesec za vse brezplačne učence skupaj (0 = brez meje)
EVKLID_FREE_STUDENT_USD=0.2       # brezplačni paket: največ $ na mesec na brezplačnega učenca
# Aktivacijska koda za prve stranke (vpiše jo ob registraciji ali v zavihku Račun; povezava /?koda=KODA).
# Ob zagonu se vpiše v bazo; nove kode in izklop ureja skrbnik v zavihku Račun.
EVKLID_PROMO_CODE=EVKLID3X      # "off" kodo izklopi
EVKLID_PROMO_LIMIT=100            # koliko računov jo lahko porabi
EVKLID_PROMO_DAYS=90              # dni polnega dostopa (3 meseci)
EVKLID_PROMO_SEATS=1              # za koliko otrok
EVKLID_PROMO_MODEL=sonnet         # imetniki kode: Sonnet ob 2. zaporedni »Razloži podrobneje«, Opus šele ob 3. (opus = brez omejitve)
EVKLID_PROMO_OPUS_DAILY=2         # skrita omejitev Opusa za imetnike kode: odgovorov na dan (nad njo tiho Sonnet)
EVKLID_PROMO_OPUS_MONTH_USD=0.3   # in $ Opusa na učenca na mesec
STRIPE_SECRET_KEY=                  # sk_test_… iz Stripe → Developers → API keys
STRIPE_WEBHOOK_SECRET=              # whsec_… (ko je aplikacija na spletu)
RESEND_API_KEY=                     # re_… iz resend.com; brez ključa se e-pošta izpiše v dnevnik
RESEND_FROM=                        # npr. Evklid <info@tvoja-domena.si>
EVKLID_DEVICE_WARN=3              # opozorilo staršu, če je profil v 30 dneh odprt na več napravah
EVKLID_WEEKLY_EMAIL=1             # 0 = ne pošiljaj tedenskih poročil
# Prodajalec na predračunu za šole (/api/admin/school-orders/:id/predracun); prazno = »[izpolni]«
EVKLID_SELLER_NAME=               # naziv podjetja ali s.p.
EVKLID_SELLER_ADDRESS=            # naslov
EVKLID_SELLER_TAX_ID=             # ID za DDV ali davčna številka
EVKLID_SELLER_IBAN=               # TRR (IBAN), na katerega šola plača e-račun prek UJP
