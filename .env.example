# Obvezno za prave odgovore (brez ključa teče preizkusni način)
ANTHROPIC_API_KEY=

# Neobvezno
PORT=3000
STEMMIND_PASSWORD=                  # če je nastavljeno, stran zahteva geslo (uporabnik je poljuben)
STEMMIND_DB=data/stemmind.db

# Modeli in stroški
STEMMIND_MODEL=claude-haiku-5-5     # privzeti, poceni model za klepet
STEMMIND_MODEL_DEEP=claude-opus-5-5 # »Razloži podrobneje« in program Tekmovanja
STEMMIND_EFFORT=low                 # low | medium | high
STEMMIND_EFFORT_DEEP=medium
STEMMIND_MAX_TOKENS=8000
STEMMIND_OCR_MODEL=                 # branje rokopisa; prazno = STEMMIND_MODEL
STEMMIND_HISTORY_TURNS=10           # koliko izmenjav zgodovine gre v API (0 = vse)
STEMMIND_ANSWER_CACHE=1             # 0 = ne uporabljaj shranjenih odgovorov na enaka prva vprašanja

# Omejitve (0 = brez omejitve)
STEMMIND_DAILY_QUESTIONS=0          # vprašanj za inštruktorja na učenca na dan, npr. 10
STEMMIND_MONTHLY_BUDGET_USD=0       # skupni mesečni proračun; pri 80 % opozorilo v dnevniku
STEMMIND_STUDENT_MONTHLY_USD=0      # mesečna omejitev na učenca, npr. 1.5

# Vnaprej pripravljene razlage tem (scripts/generate-explanations.js)
STEMMIND_EXPLANATIONS=content/explanations.json
STEMMIND_EXPLAIN_MODEL=claude-opus-5-5

STEMMIND_DEBUG=0                    # 1 = /api/students/:id/prompt pokaže sestavljeni prompt
STEMMIND_MOCK=0                     # 1 = vedno preizkusni način
