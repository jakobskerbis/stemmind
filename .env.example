# Obvezno za prave odgovore (brez ključa teče preizkusni način)
ANTHROPIC_API_KEY=

# Neobvezno
PORT=3000
KOMPRENO_PASSWORD=                  # če je nastavljeno, stran zahteva geslo (uporabnik je poljuben)
KOMPRENO_DB=data/kompreno.db

# Modeli in stroški
KOMPRENO_MODEL=claude-haiku-5-5     # privzeti, poceni model za klepet
KOMPRENO_MODEL_DEEP=claude-opus-5-5 # »Razloži podrobneje« (in Tekmovanja, če KOMPRENO_COMPETITION_DEEP=1)
KOMPRENO_EFFORT=                    # prazno = low (low | medium | high)
KOMPRENO_EFFORT_DEEP=               # prazno = low; medium = več razmišljanja Opusa (dražje)
KOMPRENO_EFFORT_THINK=              # prazno = high: Haiku za Tekmovanja in nad omejitvijo Opusa
KOMPRENO_MAX_TOKENS=                # prazno = 3000 (lahki način 1200, Haiku+razmislek 5000, Opus 6000)
KOMPRENO_DEEP_HISTORY_TURNS=        # prazno = 3: koliko zadnjih izmenjav dobi Opus
KOMPRENO_DEEP_CACHE_TTL=            # prazno = 1h: predpomnilnik prompta za Opus (5m = krajši)
KOMPRENO_COMPETITION_DEEP=0         # 1 = Tekmovanja vedno z Opusom (dražje, prej privzeto)
KOMPRENO_OCR_MODEL=                 # branje rokopisa; prazno = KOMPRENO_MODEL
KOMPRENO_HISTORY_TURNS=10           # koliko izmenjav zgodovine gre v API (0 = vse)
KOMPRENO_ANSWER_CACHE=1             # 0 = ne uporabljaj shranjenih odgovorov na enaka prva vprašanja

# Omejitve (0 = brez omejitve)
KOMPRENO_DAILY_QUESTIONS=0          # vprašanj za inštruktorja na učenca na dan, npr. 10
KOMPRENO_MONTHLY_BUDGET_USD=0       # skupni mesečni proračun; pri 80 % opozorilo v dnevniku
KOMPRENO_STUDENT_SOFT_USD=          # prazno = 1: nad tem na mesec podrobne razlage pripravi Haiku
KOMPRENO_STUDENT_MONTHLY_USD=       # prazno = 3: nad tem na mesec inštruktor počaka (Vadnica deluje)
KOMPRENO_DAILY_DEEP=                # prazno = 5: odgovorov Opusa na učenca na dan
KOMPRENO_EUR_PER_USD=               # prazno = 0.87: tečaj za prikaz stroškov v evrih

# Vnaprej pripravljene razlage tem (scripts/generate-explanations.js)
KOMPRENO_EXPLANATIONS=content/explanations.json
KOMPRENO_EXPLAIN_MODEL=claude-opus-5-5

KOMPRENO_DEBUG=0                    # 1 = /api/students/:id/prompt pokaže sestavljeni prompt
KOMPRENO_MOCK=0                     # 1 = vedno preizkusni način

# Starševski računi in plačila (1 = prijava staršev, soglasja, naročnine)
KOMPRENO_ACCOUNTS=0
KOMPRENO_BASE_URL=                  # javni naslov, npr. https://kompreno.onrender.com (za povezave v e-pošti)
KOMPRENO_ADMIN_EMAILS=              # e-naslovi skrbnikov (vidijo porabo AI, prevzamejo stare profile)
KOMPRENO_FREE_DAILY_QUESTIONS=10    # brezplačni paket: vprašanj inštruktorju na otroka na dan
KOMPRENO_FREE_POOL_USD=10           # brezplačni paket: največ $ na mesec za vse brezplačne učence skupaj (0 = brez meje)
KOMPRENO_FREE_STUDENT_USD=0.2       # brezplačni paket: največ $ na mesec na brezplačnega učenca
# Aktivacijska koda za prve stranke (vpiše jo ob registraciji ali v zavihku Račun; povezava /?koda=KODA).
KOMPRENO_PROMO_CODE=KOMPRENO100     # "off" kodo izklopi
KOMPRENO_PROMO_LIMIT=100            # koliko računov jo lahko porabi
KOMPRENO_PROMO_DAYS=365             # dni polnega dostopa
KOMPRENO_PROMO_SEATS=1              # za koliko otrok
STRIPE_SECRET_KEY=                  # sk_test_… iz Stripe → Developers → API keys
STRIPE_WEBHOOK_SECRET=              # whsec_… (ko je aplikacija na spletu)
RESEND_API_KEY=                     # re_… iz resend.com; brez ključa se e-pošta izpiše v dnevnik
RESEND_FROM=                        # npr. Kompreno <info@tvoja-domena.si>
KOMPRENO_DEVICE_WARN=3              # opozorilo staršu, če je profil v 30 dneh odprt na več napravah
KOMPRENO_WEEKLY_EMAIL=1             # 0 = ne pošiljaj tedenskih poročil
